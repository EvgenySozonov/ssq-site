---
import siteData from "../data/site.json";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** Страницы вне релиза (каркасы): запрет индексации. */
  noindex?: boolean;
}
const {
  title,
  description = "Электромонтаж и умный дом под ключ: проект, монтаж, автоматизация. Москва и область. Гарантия по договору.",
  noindex = false,
} = Astro.props;

const nav = [
  { href: "/services/", label: "Услуги" },
  { href: "/contacts/", label: "Контакты" },
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}: Умный квадрат</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#f2e3cd" />
  </head>
  <body class="bg-bg text-text font-sans">
    <!-- Навигация: плавающий пилл (draw 0f0a46) в материале Solstice: бумага-2,
         1px чернильная рамка, золотая hairline inset; телефон и CTA тише кнопки hero -->
    <header class="relative z-20 px-4 pt-2.5 sm:px-6">
      <nav
        class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-5 gap-y-3 border border-text bg-surface px-5 py-2.5"
        style="border-radius: var(--radius-pill); outline: 1px solid var(--color-gold); outline-offset: -4px"
      >
        <a
          href="/"
          class="font-display text-lg leading-none text-text no-underline"
          aria-label="Умный квадрат, на главную"
        >
          Умный квадрат
        </a>
        <ul class="flex gap-5 text-sm">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="no-underline hover:text-accent motion-safe:transition-colors">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a
          href={siteData.phoneHref}
          class="ml-auto hidden text-sm no-underline hover:text-accent motion-safe:transition-colors sm:inline"
        >
          {siteData.phone}
        </a>
        <a
          href="/contacts/"
          class="ml-auto inline-flex items-center border border-text px-5 py-2 text-sm no-underline hover:border-accent hover:text-accent motion-safe:transition-colors sm:ml-0"
          style="border-radius: var(--radius-pill)"
        >
          Оставить заявку
        </a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <!-- Колофон: один блок под волосяной линейкой, ссылки в весе текста -->
    <footer class="shell">
      <div class="mt-32 border-t border-text pt-8 pb-10">
        <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
          <div>
            <p class="font-display text-xl text-text">Умный квадрат</p>
            <p class="small-print mt-2">Электромонтаж и умный дом, Москва и область</p>
            <p class="small-print mt-0.5">Пн-Сб, 9:00-20:00</p>
          </div>
          <ul class="flex flex-wrap gap-x-8 gap-y-2 text-sm">
            <li><a href="/services/" class="no-underline hover:text-accent">Услуги</a></li>
            <li><a href="/contacts/" class="no-underline hover:text-accent">Контакты</a></li>
            <li>
              <a href="/legal/privacy/" class="no-underline hover:text-accent">Политика конфиденциальности</a>
            </li>
          </ul>
        </div>
        <p class="small-print mt-8">© 2026 «Умный квадрат». Работаем по договору, гарантия 3 года.</p>
      </div>
    </footer>
  </body>
</html>
