---
import siteData from "../data/site.json";

interface Props {
  title: string;
  description?: string;
  /** Страницы вне релиза (каркасы) — запрет индексации. */
  noindex?: boolean;
}
const {
  title,
  description = "Электромонтаж и умный дом под ключ — проект, монтаж, автоматизация. Москва и область. Гарантия по договору.",
  noindex = false,
} = Astro.props;

const nav = [
  { href: "/services/", label: "Услуги" },
  { href: "/contacts/", label: "Контакты" },
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Умный квадрат</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#fcf6ec" />
    <style>
      @import "../styles/global.css";
    </style>
  </head>
  <body class="bg-bg text-text font-sans">
    <!-- Навигация — прозрачная полоса, интегрированная с hero (AYOCIN «Transparent Hero Header»);
         конверсионный пилл — Espresso (тёмный, крем-текст, радиус 20px, стрелка в правом кармане);
         телефон в правой части, без фона (из site.json). -->
    <header class="px-4 pt-5 sm:px-6">
      <nav class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-6 gap-y-3">
        <a href="/" class="text-sm font-medium tracking-[0.2em] uppercase">SSQ //</a>
        <ul class="flex gap-5 text-sm font-medium uppercase tracking-[0.12em]">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="hover:text-text-muted motion-safe:transition-colors">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a
          href={siteData.phoneHref}
          class="ml-auto hidden text-sm font-medium hover:text-text-muted motion-safe:transition-colors sm:inline"
        >
          {siteData.phone}
        </a>
        <a
          href="/contacts/"
          class="inline-flex items-center gap-3 bg-accent py-2.5 pl-5 pr-4 text-sm font-medium uppercase tracking-[0.08em] text-accent-contrast hover:opacity-90 focus-visible:outline-2 focus-visible:outline-accent motion-safe:transition-opacity"
          style="border-radius: var(--radius-btn); border: 1px solid var(--color-accent)"
        >
          Контакты <span aria-hidden="true">→</span>
        </a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="border-t border-line py-10 text-center text-sm text-text-muted">
      <slot name="footer">
        <p>Умный квадрат · электромонтаж и умный дом · Москва и область</p>
      </slot>
    </footer>
  </body>
</html>
