---
/**
 * Обзор направлений услуг: карточки из lines.json (единый источник маршрутов).
 * Добавление третьего направления — правка lines.json, ноль правок кода.
 * Рестайл AYOCIN (2026-11-17): Ivory Sand банд, карточки 10px без теней.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLines } from "../../lib/lines";

const lines = getLines();

/* Фото направлений — CC0 StockSnap; источники: docs/references/landing-images-sources.md */
const lineImages: Record<string, { src: string; alt: string }> = {
  elektromontazh: {
    src: "/images/direction-electromontazh.jpg",
    alt: "Электромонтажник устанавливает выключатель на белой стене",
  },
  "umniy-dom": {
    src: "/images/direction-umniy-dom.jpg",
    alt: "Тёплый вечерний свет в столовой загородного дома",
  },
};
---

<BaseLayout
  title="Услуги"
  description="Направления услуг «Умного квадрата»: электромонтаж и умный дом под ключ — разводка, щит, свет, сценарии, климат. Москва и область."
>
  <section class="shell mt-6 sm:mt-10">
    <header class="mb-10 max-w-2xl">
      <h1>Направления услуг</h1>
      <p class="lead mt-5">
        Электромонтаж и умный дом проектируются как одно целое: щит, свет, климат, безопасность и сценарии
        проектируются вместе. Внутри каждого направления есть навигатор услуг и цены-ориентиры.
      </p>
    </header>
    <div class="grid gap-5 sm:grid-cols-2">
      {
        lines.map((line) => (
          <a
            href={`/services/${line.slug}/`}
            class="group block border-2 border-text bg-surface shadow-[10px_10px_0_var(--color-well)] text-text no-underline hover:-translate-y-1 motion-safe:transition-transform"
            style="border-radius: var(--radius-s)"
          >
            {
              lineImages[line.slug] && (
                <div class="photo-frame">
                  <img
                    src={lineImages[line.slug].src}
                    alt={lineImages[line.slug].alt}
                    class="aspect-[4/3] w-full object-cover"
                    width="960"
                    height="720"
                    loading="lazy"
                  />
                </div>
              )
            }
            <div class="p-8">
              <h2 class="mb-2 text-2xl group-hover:text-accent motion-safe:transition-colors">{line.title}</h2>
              <p class="text-text-muted">{line.tagline}</p> <span class="small-print mt-3 block">Услуги и цены</span>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
