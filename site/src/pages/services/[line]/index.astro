---
/**
 * Посадочная направления: /services/[line]/ — строится циклом по lines.json
 * (каркас: добавление направления = запись в JSON, ноль правок кода).
 * Приём из досье GWI: навигатор «Что вы ищете?» — якорное оглавление услуг
 * (docs/references/globalwaveintegration-reference.md §3).
 * Рестайл AYOCIN (2026-11-17): Ivory Sand навигатор, карточки 10px, пилл-CTA.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getLines, getLineServices } from "../../../lib/lines";

export function getStaticPaths() {
  return getLines().map((line) => ({ params: { line: line.slug }, props: { line } }));
}

const { line } = Astro.props;
const services = getLineServices(line.slug);

const priceLabel = (priceFrom: number): string =>
  priceFrom > 0
    ? `от ${new Intl.NumberFormat("ru-RU", { maximumFractionDigits: 0 }).format(priceFrom)} ₽`
    : "по смете";
---

<BaseLayout
  title={`${line.title} — услуги`}
  description={`${line.title} под ключ: ${line.tagline}. Смета и договор до старта, гарантия 3 года. Бесплатный выезд для замера по Москве и области.`}
>
  <section class="shell mt-6 sm:mt-10">
    <header class="mb-10 max-w-2xl">
      <h1>{line.title}</h1>
      <p class="lead mt-5">
        {line.tagline}. Работаем по договору, смета фиксируется до старта, гарантия 3 года.
      </p>
      <a href="/contacts/" class="btn btn-primary">
        Бесплатный выезд для замера
      </a>
    </header>

    <!-- Навигатор-оглавление: якоря секций ниже, без JS (эвристика 6: выбор виден сразу) -->
    <nav aria-label={`Услуги направления ${line.title}`} class="well mb-12 p-6 sm:p-7" style="border-radius: var(--radius-s)">
      <h2 class="text-xl">
        Что вы ищете?
      </h2>
      <ul class="grid gap-2">
        {
          services.map((service) => (
            <li>
              <a href={`#${service.slug}`} class="price-row no-underline">
                <span class="small-print"> {service.title}</span>
                <b>{priceLabel(service.priceFrom)}</b>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex flex-col gap-10 border-t border-line pt-10">
      {
        services.map((service) => (
          <section id={service.slug} class="scroll-mt-28 border-t-2 border-text pt-6">
            <div class="flex items-baseline justify-between gap-6">
              <h2>{service.title}</h2>
              <span class="small-print">{priceLabel(service.priceFrom)}</span>
            </div>
            <p class="mb-4 max-w-2xl text-text-muted">{service.summary}</p>
            <a
              href="/contacts/"
              class="btn btn-secondary mt-2 inline-flex no-underline"
            >
              Получить расчёт
            </a>
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>
