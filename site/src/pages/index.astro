---
/**
 * Главная. Редизайн 2026-11-18: тема Solstice (Hallmark, draw 0f0a46),
 * hero Ledge, сигнатура «рулированная смета» (well с золотыми пунктирами и Yeseva-цифрами).
 * Претензии наград/брендов не копируем: только честные обязательства и цены из data/services.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import siteData from "../data/site.json";
import { getLines, getLineServices } from "../lib/lines";

const lines = getLines().map((line) => ({ ...line, services: getLineServices(line.slug) }));

const priceLabel = (priceFrom: number): string =>
  priceFrom > 0
    ? `от ${new Intl.NumberFormat("ru-RU", { maximumFractionDigits: 0 }).format(priceFrom)} ₽`
    : "по смете";

const whyValues = [
  {
    title: "Договор и смета до старта",
    text: "Состав работ, материалы, цена и сроки фиксируются до монтажа.",
  },
  {
    title: "Гарантия 3 года",
    text: "По договору, с документами и протоколами тестов линий.",
  },
  { title: "Чистый монтаж", text: "Убираем за собой, стыкуемся с вашим ремонтом по дням." },
  {
    title: "Обучение сценариям",
    text: "Показываем и объясняем: вы управляете домом сами с первого дня.",
  },
  {
    title: "Сервис после сдачи",
    text: "Остаёмся на связи: правки сценариев и поддержка после сдачи объекта.",
  },
];

const steps = [
  {
    title: "Заявка и осмотр",
    text: "Звоните или пишете. Обсуждаем задачу, приезжаем, замеряем, предлагаем решения.",
  },
  {
    title: "Смета и договор",
    text: "Состав работ, материалы, цену и сроки фиксируем до старта. Смета не меняется без вашего решения.",
  },
  {
    title: "Монтаж",
    text: "Работаем по графику, стыкуемся с вашим ремонтом по дням, убираем за собой.",
  },
  {
    title: "Сдача",
    text: "Показываем, объясняем, настраиваем сценарии. Отдаём документы и протоколы тестов линий.",
  },
];
---

<BaseLayout
  title="Электромонтаж и умный дом под ключ"
  description="Электромонтаж и умный дом под ключ: разводка, щит, свет и сценарии. Договор и смета до старта, гарантия 3 года. Бесплатный выезд для замера по Москве и области."
>
  <!-- Hero Ledge: поле фото сверху, заголовок в покое у подножия первого экрана -->
  <section class="pt-2">
    <div class="photo-frame relative overflow-hidden" style="height: clamp(300px, 40dvh, 640px)">
      <img
        src="/images/hero-living-room.jpg"
        alt="Светлая гостиная с камином, отделка после электромонтажа"
        class="absolute inset-0 size-full object-cover"
        width="1024"
        height="694"
        fetchpriority="high"
      />
    </div>
  </section>
  <section class="shell pt-10 sm:pt-14">
    <div class="max-w-[760px]">
      <h1>Электрика и умный дом одним проектом</h1>
      <p class="lead mt-5">
        От разводки и щита до сценариев, которые работают одним касанием. Подключаемся на этапе
        ремонта.
      </p>
      <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6">
        <a href="/contacts/" class="btn btn-primary">
          Заказать бесплатный замер
        </a>
        <a href="/services/" class="btn btn-secondary no-underline">
          Смотреть услуги
        </a>
      </div>
      <p class="small-print mt-6">Разводка электрики от 1 800 ₽. Гарантия 3 года. Договор и смета до старта. Москва и область.</p>
    </div>
  </section>

  <!-- Сигнатура: рулированная смета. Offer первой секцией после hero (draw 0f0a46) -->
  <section class="shell mt-32" aria-labelledby="pricing">
    <div class="mb-12 max-w-[640px]">
      <h2 id="pricing">Ориентиры по ценам</h2>
      <p class="lead mt-4">Смета фиксируется до старта и не меняется без вашего решения.</p>
    </div>
    <div class="grid gap-8 lg:grid-cols-2">
      {lines.map((line) => (
        <div class="well p-7 sm:p-8">
          <h3 class="text-base font-medium [font-family:var(--font-sans)]">{line.title}</h3>
          <div class="mt-4">
            {line.services.map((service) => (
              <div class="price-row">
                <span class="small-print">{service.title}</span>
                <b>{priceLabel(service.priceFrom)}</b>
                <span class="small-print col-span-full opacity-80">{service.summary}</span>
              </div>
            ))}
          </div>
          <a href={`/services/${line.slug}/`} class="btn btn-secondary no-underline mt-6">
            Все услуги направления
          </a>
        </div>
      ))}
    </div>
    <div class="mt-10 flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-8">
      <a href="/contacts/" class="btn btn-primary">
        Заказать бесплатный замер
      </a>
      <p class="small-print">Выезд и замер бесплатны.</p>
    </div>
  </section>

  <!-- Split: подход, фото справа -->
  <section class="shell mt-36" aria-labelledby="approach">
    <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
      <div>
        <h2 id="approach">Один подрядчик, две инженерии</h2>
        <p class="mt-6 max-w-[52ch] text-text-muted">
          Электрику и автоматизацию проектируем вместе: щит, освещение, климат, безопасность и
          сценарии работают как одно целое.
        </p>
        <a href="/services/" class="btn btn-secondary no-underline mt-8">Услуги и цены по направлениям</a>
      </div>
      <div class="photo-frame relative overflow-hidden">
        <img
          src="/images/direction-umniy-dom.jpg"
          alt="Тёплый вечерний свет в столовой загородного дома"
          class="w-full object-cover"
          style="aspect-ratio: 4/3"
          width="960"
          height="720"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- Rows: обязательства -->
  <section class="shell mt-36" aria-labelledby="values">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)]">
      <div>
        <h2 id="values">Договор, гарантия и порядок</h2>
      </div>
      <ul>
        {whyValues.map((value) => (
          <li class="grid gap-1 border-t border-line py-5 sm:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] sm:gap-6">
            <h3 class="text-xl">{value.title}</h3>
            <p class="self-end text-text-muted">{value.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Steps: четыре стадии, настоящий <ol> -->
  <section class="shell mt-36" aria-labelledby="process">
    <h2 id="process">Как идёт работа</h2>
    <ol class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, i) => (
        <li class="border-t-2 border-text pt-4">
          <span class="block font-display text-3xl" aria-hidden="true">
            {i + 1}
          </span>
          <h3 class="mt-3 text-xl">{step.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-text-muted">{step.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- Закрытие: заявка рядом с последним фото (split зеркальный) -->
  <section class="shell mt-40" aria-labelledby="closing">
    <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]">
      <div class="photo-frame relative overflow-hidden">
        <img
          src="/images/hero-pendant-lights.jpg"
          alt="Подвесные светильники в тёплом вечернем свете"
          class="w-full object-cover"
          style="aspect-ratio: 4/3"
          width="1024"
          height="694"
          loading="lazy"
        />
      </div>
      <div>
        <h2 id="closing">Обсудим ваш проект?</h2>
        <p class="mt-6 max-w-[48ch] text-text-muted">
          Начнём с бесплатного выезда и замера. Заявки берём в работу в течение рабочего дня.
        </p>
        <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6">
          <a href="/contacts/" class="btn btn-primary">
            Оставить заявку
          </a>
          <a href={siteData.phoneHref} class="btn btn-secondary no-underline">
            Позвонить: {siteData.phone}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
